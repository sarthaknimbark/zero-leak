# Same Supabase project the Vercel frontend already uses (preserves existing data)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# Web Push — public key MUST match client/src/hooks/usePushNotifications.ts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@zeroleak.app

# Server
PORT=3001
NODE_ENV=production

# Comma-separated. Include your real Vercel URL + local + optional wildcard for previews
ALLOWED_ORIGINS=http://localhost:5173,https://zero-leak-nine.vercel.app,https://*.vercel.app

# Protects POST /internal/send-reminders
CRON_SECRET=generate_a_long_random_secret
