    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
